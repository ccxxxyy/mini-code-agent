{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/ccmetr/bin/ccmetr-client.py",
              "hook",
              "UserPromptSubmit"
            ],
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/ccmetr/bin/ccmetr-client.py",
              "session-start"
            ],
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/ccmetr/bin/ccmetr-client.py\" statusline",
    "refreshInterval": 5,
    "padding": 1
  },
  "permissions": {
    "allow": [
      "Bash(.claude/ccmetr/bin/ccmetr *)"
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
