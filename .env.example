# Mini-Code-Agent 环境变量配置
# 将此文件中的占位值替换为你的实际 API 密钥

# API 密钥（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# API 地址（使用第三方 OpenAI 兼容 API 时设置，如 DeepSeek、智谱、硅基流动等）
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名称（可选，默认 gpt-4o）
# MINI_AGENT_MODEL=gpt-4o

# ===== 多模型切换（可选）=====
# 定义多个命名模型后，在界面中用 /model <名称> 一键切换
# 未指定的字段（API_KEY/BASE_URL/PROVIDER）自动继承上面的默认配置
#
# MINI_AGENT_MODELS=fast,smart
#
# MODEL_FAST_MODEL=deepseek-chat
# MODEL_FAST_BASE_URL=https://api.deepseek.com/v1
# MODEL_FAST_API_KEY=sk-xxxx
#
# MODEL_SMART_MODEL=claude-sonnet-4-20250514
# MODEL_SMART_PROVIDER=anthropic
# MODEL_SMART_API_KEY=sk-ant-xxxx
