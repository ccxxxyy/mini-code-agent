# Mini-Code-Agent 环境变量配置
# 将此文件中的占位值替换为你的实际 API 密钥

# API 密钥（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# API 地址（使用第三方 OpenAI 兼容 API 时设置，如 DeepSeek、智谱、硅基流动等）
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名称（可选，默认 gpt-4o）
# MINI_AGENT_MODEL=gpt-4o

# Provider 协议（可选，默认 openai）："openai" | "openai-responses" | "anthropic"
# MINI_AGENT_PROVIDER=openai

# ===== 多模型切换（可选）=====
# 定义多个命名模型后，在界面中用 /model <名称> 一键切换
# 未指定的字段（API_KEY/BASE_URL/PROVIDER）自动继承上面的默认配置
#
# MINI_AGENT_MODELS=fast,smart
#
# MODEL_FAST_MODEL=deepseek-chat
# MODEL_FAST_BASE_URL=https://api.deepseek.com/v1
# MODEL_FAST_API_KEY=sk-xxxx
#
# MODEL_SMART_MODEL=claude-sonnet-4-20250514
# MODEL_SMART_PROVIDER=anthropic
# MODEL_SMART_API_KEY=sk-ant-xxxx
# MODEL_SMART_THINKING=true

# ===== 发送侧 extended thinking（可选）=====
# Anthropic / OpenAI Responses 模型需在请求侧显式开启才会思考
# （DeepSeek 类自动输出思考过程的模型无需设置）
# 也可在 .mini-agent/config.toml 的 [llm] 段设 thinking = true
#
# MINI_AGENT_THINKING=true

# ===== 强弱模型混编（可选）=====
# 多 Agent 编排时 Planner（分解任务）和 Worker（执行子任务）用不同模型
# 实验验证（experiments/README.md）：强 Planner + 弱 Worker 全通过且成本最低
# 值为上面 MINI_AGENT_MODELS 定义的 profile 名；未配置时都用主模型
#
# MINI_AGENT_PLANNER_PROFILE=smart
# MINI_AGENT_WORKER_PROFILE=fast
