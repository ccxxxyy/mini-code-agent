# Mini-Code-Agent 配置文件示例
# 复制到 ~/.mini-agent/config.toml（用户级）或 .mini-agent/config.toml（项目级）
# 项目级配置覆盖用户级；环境变量覆盖 TOML；CLI 参数覆盖一切
# 未设置的字段使用内置默认值

# 顶层字段 Top-level fields:
# max_agent_iterations = 50           # 每轮对话最大 ReAct 迭代数
# max_consecutive_denials = 1         # 确认框被拒 N 次后停下回问用户（危险命令/项目外路径/hook 确认；默认 1，拒一次即停；防绕过）
# streaming_tool_execution = true     # 流式期间工具组装完成即执行（false 回退流后执行）

[llm]
# provider = "openai"
# model = "deepseek-chat"
# temperature = 0.0
# max_tokens = 4096
# timeout = 120.0

[tools]
# bash_timeout = 120.0
# max_file_size = 10000000
# enabled_tools = ["read_file", "write_file", "edit_file", "delete_file", "bash", "glob", "grep", "spawn_agents", "send_message", "wait_message", "tool_search", "mcp_call", "ask_user", "exit_plan_mode", "task_create", "task_get", "task_list", "task_update", "load_skill", "install_skill"]
# denied_paths = ["~/.ssh", "~/.aws", "~/.gnupg"]
# enforce_read_before_edit = true   # edit/overwrite requires a prior read (read-before-edit gate); false disables

[memory]
# context_window = 128000
# compression_threshold = 0.75        # soft threshold, controlled by circuit breaker 软阈值，受熔断器控制
# hard_compression_threshold = 0.90   # hard threshold, bypasses circuit breaker 硬阈值，绕过熔断器强制压缩
# auto_extract = true
# spill_threshold_chars = 50000  # tool results above this spill to disk, 0 = off 工具结果超此字符数溢写磁盘，0 禁用
# aggregate_spill_chars = 200000 # per-turn aggregate budget: force-spill largest when total exceeds, 0 = off 单轮聚合预算：累计超此值时按大小强制溢写，0 禁用
# llm_summarize = true           # LLM semantic summary for compression (false = extractive truncation) 压缩用 LLM 语义摘要（false = 抽取式截断）

[security]
# permission_mode = "ask"    # "allow" | "ask" | "deny"
# allowed_commands = ["git *", "npm *", "python *", "uv *"]
# sandbox = true             # OS 沙箱（Linux bwrap/unshare / macOS seatbelt / Windows 管理员 Low Integrity），默认开启
# sandbox_auto_allow = false # 沙箱下危险命令免确认（deny 规则仍拦）
# sandbox_network = false    # 允许沙箱内网络访问

[context]
# 上下文感知：项目指令文件名及优先级（第一个命中即用）
# instruction_files = ["AGENT.md", "CLAUDE.md", ".mini-agent/instructions.md"]
# 用户级全局指令文件
# user_instructions_file = "~/.mini-agent/instructions.md"
# 单文件截断长度（字符，展开后整体截断）
# max_chars = 8000
# @-include 递归展开最大深度（0 禁用）
# max_include_depth = 5

[cost]
# 成本仪表盘：/cost 查看，每轮结束超预算时警告
# budget = 5.0                   # 本会话预算上限（元），0 或不设 = 不限
# total_budget = 50.0            # 累计总账预算上限（元），/cost reset 后重新计
# currency = "¥"
# 每模型价格（元/百万 token，input/output 分开——按 API 供应商定价填写）
# [cost.pricing.deepseek-chat]
# input = 2.0
# output = 8.0
# [cost.pricing.deepseek-v4-flash-0731]
# input = 0.15
# output = 1.5

# 顶级配置
# max_agent_iterations = 50
# theme = "default"          # "default" | "dark" | "light"

# 插件生态：第三方注册工具/命令/技能
# 本地文件插件目录（.py 文件，契约见 extensions/plugin_loader.py docstring）
# plugin_dirs = ["./.mini-agent/plugins", "~/.mini-agent/plugins"]
# 禁用插件：按 entry-point 名或文件名（去 .py 后缀）匹配
# disabled_plugins = ["some_plugin"]

# 自定义 Agent 类型（B3）：*.md 文件声明 agent 类型（YAML frontmatter + body 作为 system prompt）
# agent_dirs = ["~/.mini-agent/agents", "./.mini-agent/agents"]

# MCP 服务器配置（启动时自动连接，工具注册为 mcp_<服务器名>_<工具名>）
# stdio 传输（子进程）
# [mcp.servers.github]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-github"]
# transport = "stdio"
#
# HTTP 传输（远程服务器）
# [mcp.servers.remote-api]
# url = "http://localhost:8080/mcp"
# transport = "http"
# headers = { Authorization = "Bearer your-token-here" }   # 可选认证头

# 声明式 Hook 规则（详见 docs/guide/config-guide.md "Hook 规则详解"）
# 命中的工具调用被拒绝执行（默认）或弹窗确认，reason 回给 LLM。可写多条 [[hooks]]。
# 注意：[[hooks]] 必须写在所有顶级键之后；regex 用单引号（literal string）
# [[hooks]]
# tool = "write_file"        # 工具名 fnmatch 模式（"bash"、"write_*"，默认 "*" 全部）
# arg = "file_path"          # 可选：只检查此参数（缺省检查所有参数值）
# contains = "docs/spec"     # 可选：参数值包含此子串才触发
# reason = "docs/spec.md 项目策略只读"
#
# [[hooks]]
# tool = "bash"
# regex = 'rm\s+-rf'         # 可选：re.search 正则；与 contains 同给须同时命中
# reason = "破坏性删除被项目策略禁止"
#
# [[hooks]]
# tool = "bash"
# contains = "git push"
# action = "confirm"         # 可选："block"（默认）拒绝；"confirm" 弹 y/a/n 确认框
# reason = "push 会影响远程仓库"
