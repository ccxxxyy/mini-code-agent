# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Test coverage artifacts (regenerated by pytest --cov) 覆盖率产物（pytest --cov 重新生成）
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environment
.venv/

# IDE
.idea/
.vscode/
*.swp

# Environment
.env
!.env.example

# uv
uv.lock

# OS
.DS_Store
Thumbs.db

# Mini-Agent data
.mini-agent/

# Cache directories (regenerable) 缓存目录（可重新生成）
.pytest_cache/
.ruff_cache/

# Benchmark/experiment run output (live dirs; re-runs shouldn't dirty the tree)
# 评测/实验的运行时输出目录（重跑不污染工作区）
# 提交版证据快照在 *-snapshot* 目录，不在此列。
# results-* covers per-model dirs from `runner.py --results-dir`
# results-* 匹配 `runner.py --results-dir` 产生的按模型分目录
benchmarks/results/
benchmarks/results-[a-z]*/
!benchmarks/results-snapshot*/
experiments/results/

# 个人求职材料（不提交）
简历与面试准备.md
